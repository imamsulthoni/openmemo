{
  "name": "api",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm with-env tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:generate": "pnpm with-env prisma generate",
    "db:deploy": "pnpm with-env prisma deploy",
    "db:studio": "pnpm with-env prisma studio",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@anvia/core": "^0.15.0",
    "@anvia/memory-prisma": "^0.2.4",
    "@anvia/server": "^0.5.13",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.9.0",
    "@mdpdf/mdpdf": "^0.1.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@openmemo/agent": "workspace:*",
    "bullmq": "^5.81.2",
    "hono": "^4.12.32",
    "ioredis": "^5.11.1",
    "prisma": "^7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
